# Скопируйте в .env и подставьте свои значения.
# Не коммитьте настоящий .env в публичный репозиторий.

# --- AiTunnel (OpenAI-совместимый API) ---
AITUNNEL_API_KEY="sk-aitunnel-VASHE_ZNACHENIE"
AITUNNEL_BASE_URL="https://api.aitunnel.ru/v1"

# --- Эмбеддинги (локальная sentence-transformers) ---
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIM=384

# --- UI ---
TOP_K=3
DEFAULT_TEMPERATURE=0.7

# --- Web Search (Бот №4) ---
WEB_SEARCH_MAX_RESULTS=5

# --- Хронологическая история (SQLite) ---
# Используется Ботами №2/№3/№4. Путь по умолчанию: <корень проекта>/history.db.
# При необходимости можно переопределить абсолютный путь:
# DB_PATH="D:/multibot-platform/history.db"
